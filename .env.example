# TrailTurn demo server
PORT=3000
HOST=127.0.0.1
NODE_ENV=development

# Optional. A random secret is generated into data/.receipt-secret on first run.
# Set this in a deployed environment so receipt links survive a fresh filesystem.
# RECEIPT_SECRET=replace-with-a-long-random-string

# Optional operator search at /ops. Leave empty to disable.
# OPS_TOKEN=replace-with-a-long-random-string

# Optional. Set to 1 only behind a trusted reverse proxy that sets X-Forwarded-For
# and X-Forwarded-Proto.
# TRUST_PROXY=0

# Optional paths
# DATA_DIR=./data
# DB_PATH=./data/trailturn.db
